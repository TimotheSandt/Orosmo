// Panneau de performances de la démo, en haut à gauche. La vue décrit ; les valeurs (rafraîchies environ 4 fois par seconde) sont
// calculées en C++ (UI/performance_stats.cpp) ; l'apparence vient du thème res/themes/hud.json. Langage : docs/UI_LANGUAGE.md.
import "orosmo/ui"
import "UI/performance_stats.hpp"

view PerformanceView {
    @Observed var stats: PerformanceStats

    Panel {
        Label("FPS: \(stats.shown.fps)").variant("hudTitle").id("fps")
        Label("Render: \(stats.shown.renderMs) ms").variant("hudMetric").id("render")
        Label("Render Scene: \(stats.shown.renderSceneMs) ms").variant("hudMetric").id("renderScene")
        Label("Upscale: \(stats.shown.upscaleMs) ms").variant("hudMetric").id("upscale")
        Label("UI Upscale: \(stats.shown.uiUpscaleMs) ms").variant("hudMetric").id("uiUpscale")
        Label("Swap Buffers: \(stats.shown.swapBuffersMs) ms").variant("hudMetric").id("swapBuffers")
        Label("Esc: Open UI").variant("hudMetric").id("hint")
    }
    .variant("hud")
    .width(260)
    .height(.fit)
    .align(.start)
}
