// Panneau de performances de la démo : mesures en haut à gauche, historique des temps d'image en bas à droite. La vue décrit ; le
// niveau affiché (--hud, Ctrl+F), les mesures et leurs textes (rafraîchis environ 4 fois par seconde) sont calculés en C++
// (UI/performance_stats.cpp) ; l'apparence vient du thème res/themes/hud.json. Langage : docs/UI_LANGUAGE.md.
import "orosmo/ui"
import "UI/performance_stats.hpp"

view PerformanceView {
    @Observed var stats: PerformanceStats

    Overlay {
        Panel {
            Label(stats.text.fps).variant("hudTitle").id("fps")
            Label(stats.text.fpsDetail).variant("hudMetric").id("fpsDetail").visible(stats.showDetails())
            Label(stats.text.frame).variant("hudMetric").id("frame").visible(stats.showDetails())
            Label(stats.text.gpu).variant("hudMetric").id("gpu").visible(stats.showDetails())
            Label(stats.passLine(0)).variant("hudDetail").id("passes0").visible(stats.showPassLine(0))
            Label(stats.passLine(1)).variant("hudDetail").id("passes1").visible(stats.showPassLine(1))
            Label(stats.passLine(2)).variant("hudDetail").id("passes2").visible(stats.showPassLine(2))
            Label(stats.text.cpu).variant("hudDetail").id("cpu").visible(stats.showDetails())
            Label(stats.text.draws).variant("hudDetail").id("draws").visible(stats.showDetails())
            Label(stats.text.objects).variant("hudDetail").id("objects").visible(stats.showDetails())
            Label(stats.text.device).variant("hudDetail").id("device").visible(stats.showDetails())
            Label(stats.text.resolution).variant("hudDetail").id("resolution").visible(stats.showDetails())
            Label(stats.text.modes).variant("hudDetail").id("modes").visible(stats.showDetails())
            Label(stats.text.memory).variant("hudDetail").id("memory").visible(stats.showDetails())
            Label("Esc: Open UI   Ctrl+F: HUD level").variant("hudMetric").id("hint").visible(stats.showDetails())
        }
        .variant("hud")
        .width(.fit)
        .height(.fit)
        .align(x: .start, y: .start)
        .visible(stats.showFps())
        .id("hudPanel")

        Panel {
            Label(stats.text.cpuGraph).variant("hudDetail").id("cpuGraphLabel")
            Plot(values: stats.cpuHistory()).variant("hudPlotCpu").width(.fill).height(70).id("cpuGraph")
            Label(stats.text.gpuGraph).variant("hudDetail").id("gpuGraphLabel")
            Plot(values: stats.gpuHistory()).variant("hudPlotGpu").width(.fill).height(70).id("gpuGraph")
        }
        .variant("hud")
        .width(400)
        .height(.fit)
        .align(x: .end, y: .end)
        .visible(stats.showGraph())
        .id("hudGraph")
    }
}
