// TOOL-01 / TER-12 : panneau de réglage du visualiseur. La vue décrit ; la logique est dans viewer_state.cpp ; l'apparence vient
// du thème (res/themes). Spécification du langage : docs/UI_LANGUAGE.md.
import "engine/ui"
import "viewer_state.hpp"

view TerrainPanel {
    @Mutable var state: ViewerState
    @Observed var stats: ViewerStats

    Panel {
        Label("Terrain").variant("title")
        Grid(2) {
            Label("Seed")
            HBox {
                NumberField($state.seed, integer: true, min: 0, max: 4294967295).width(.fill).onChange(state.regenerate).id("seed")
                Button("Random").onClick(state.randomizeSeed).tooltip("New random seed (logged)").id("random")
            }
            .width(.fill)
            Label("Preset")
            HBox {
                Dropdown(options: state.presetNames(), selected: $state.preset).width(.fill).onChange(state.applyPreset).id("preset")
                Button("Save").onClick(state.savePreset).tooltip("Save the parameters as presets/custom.json").id("save")
            }
            .width(.fill)
            Label("Theme")
            Dropdown(options: state.themeNames(), selected: $state.theme).width(.fill).onChange(state.applyTheme).id("theme")
        }
        Checkbox("Live update", checked: $state.live).tooltip("Regenerate while a parameter changes").id("live")
        Separator()
        ScrollView {
            ParamPanel($state.params).onChange(state.paramsChanged).id("params")
        }
        .height(.fill)
        Separator()
        HBox {
            Button("Generate").onClick(state.regenerate).width(.fill).id("generate")
            Button("Export PNG").onClick(state.exportHeightmap).width(.fill).tooltip("1024 x 1024 16-bit height map around the camera").id("export")
        }
        Label("\(stats.fps) FPS  -  \(stats.tiles) tiles, \(stats.pending) pending, \(stats.memoryMb) MB").variant("caption").id("stats")
        Plot(values: stats.frameTimes).height(36).tooltip("Frame time (ms)")
        Label("\(state.status)").variant("caption").id("status")
    }
    .width(360)
    .height(.fill)
    .margin(12)
    .align(.start)
}
