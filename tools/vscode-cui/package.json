{
  "name": "cui-language",
  "displayName": "CUI Language Support",
  "description": "Interface language (.cui) of the Orosmo engine: highlighting, compiler diagnostics (file:line:column), completion and hover from `cui spec`",
  "version": "0.3.0",
  "publisher": "orosmo",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./main.js",
  "activationEvents": [
    "onLanguage:cui"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cui",
        "aliases": [
          "CUI",
          "cui"
        ],
        "extensions": [
          ".cui"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cui",
        "scopeName": "source.cui",
        "path": "./syntaxes/cui.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "CUI DSL",
      "properties": {
        "cui.toolPath": {
          "type": "string",
          "default": "",
          "description": "Path to the cui compiler. Empty: tools/cui, tools/target/release/cui, engine/tools/cui (projects made by `engine init`) in the workspace, then the PATH."
        }
      }
    },
    "commands": [
      {
        "command": "cui.showOutput",
        "title": "CUI: Show the extension log"
      }
    ]
  }
}
