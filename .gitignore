# ── Build outputs ─────────────────────────────────────────────────────────────
/build/
/dist/
/lib/
/obj/
vcpkg_installed
bin/
obj/
Generated/
logs/
*.log
imgui.ini
# Sorties de terrain-gen ou des démos lancées à la racine (relief.png, rhi-demo.png...) : jamais suivies
/*.png
/*.exr
/*.obj
/*.gltf
/*.stl

# Engine copied/linked into the demo, per-machine overrides
/apps/*/orosmo/
/apps/*/vcpkg_installed/
config.local.mk

# Rust tools (cui, engine-init)
/tools/target/
/tools/.target*/
/tools/*/target/
/tools/cui
/tools/cui.exe
/tools/orosmo
/tools/orosmo.exe

