compile_commands.json
.vscode/
.vs/
.idea/
.VSCodeCounter/
.claude/
.cache/
*.user
*.swp
*~
*.bak
*.tmp
.DS_Store
Thumbs.db
__pycache__/

# Local artefacts that must never be committed
*.bundle

# Caches de la CI (ccache, archives vcpkg) si on les crée en local
/.ccache/
/.vcpkg-archives/
