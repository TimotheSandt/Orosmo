# Normalisation des fins de ligne : LF dans le dépôt et à l'extraction.
* text=auto eol=lf

# Scripts Windows : CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.nsi text eol=crlf

# Binaires
*.ttf binary
*.ico binary
*.png binary
*.jpg binary
*.exe binary
*.dll binary
*.lib binary
*.a binary
*.zip binary
