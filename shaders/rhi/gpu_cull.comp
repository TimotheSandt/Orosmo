#version 450
// REN-29 : culling et LOD sur le GPU (GpuDrivenFeature, passe « gpudriven.cull »). Un fil par emplacement de la scène GPU
// (GpuScene) : mêmes règles, dans le même ordre, que le culling CPU (culling.cpp : pyramide, distance, taille à l'écran ;
// lod.cpp : selectLod), puis, avec OROSMO_HIZ, occlusion contre la pyramide de profondeur (Hi-Z) de l'image PRÉCÉDENTE. Chaque
// instance visible est ajoutée (compteur atomique) à la commande indirecte de sa clé (maillage, matériau) et écrite au format
// GpuInstance (instance_batch.hpp) dans la plage de cette commande : le dessin indirect lit le résultat sans retour au CPU.

layout(local_size_x = 64) in;

struct SceneObject // GpuSceneObject (gpu_scene.hpp)
{
    vec4 model[4];
    vec4 normal[3];
    vec4 color;
    vec4 boundsMin;
    vec4 boundsMax;
    uvec4 info; // drapeaux (bit 0 : vivant), niveaux, réglages de LOD, matériau
    uvec4 lods[2];
};

struct LodSettings // GpuLodSettings
{
    vec4 switches[2];
    vec4 params; // largeur du fondu, distance de rejet, biais, nombre de bascules
};

struct DrawCommand // rhi::DrawIndexedIndirectCommand
{
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};

struct Instance // GpuInstance
{
    vec4 model[4];
    vec4 normal[3];
    vec4 color;
};

layout(set = 0, binding = 0, std140) uniform CullBlock // GpuCullParams (gpu_driven.cpp)
{
    vec4 planes[6];
    mat4 occlusionViewProj; // vue-projection (monde) de l'image qui a construit la Hi-Z
    vec4 eye;               // xyz : œil (monde), w : nombre de plans
    vec4 origin;            // xyz : origine du rendu relatif à la caméra (retranchée des translations)
    vec4 view;              // échelle de projection, hauteur du viewport, rayon minimal (pixels), distance maximale
    vec4 hiz;               // largeur, hauteur (niveau 0), nombre de niveaux, réservé
    uvec4 counts;           // emplacements, maillages, matériaux, drapeaux (1 : orthographique, 2 : pyramide, 4 : LOD)
} cull;

layout(set = 0, binding = 1, std430) readonly buffer Objects { SceneObject objects[]; };
layout(set = 0, binding = 2, std430) readonly buffer Lods { LodSettings lodSettings[]; };
// Rang de chaque maillage (commande = matériau × maillages + rang), puis capacité de chaque commande.
layout(set = 0, binding = 3, std430) readonly buffer Tables { uint tables[]; };
layout(set = 0, binding = 4, std430) buffer Commands { DrawCommand commands[]; };
layout(set = 0, binding = 5, std430) writeonly buffer Instances { Instance instances[]; };
// Compteurs (GpuCullStats), puis drapeaux de visibilité par emplacement (bit 0 vivant, 1 pyramide/distance/taille, 2 occlusion,
// 3 dessiné).
layout(set = 0, binding = 6, std430) buffer Stats
{
    uint stats[16];
    uint visibility[];
};
#ifdef OROSMO_HIZ
layout(set = 1, binding = 0) uniform sampler2D hizTexture; // R32F, mips : profondeur la plus LOINTAINE (reverse-Z : minimum)
#endif

const uint kObjects = 0u;
const uint kFrustumCulled = 1u;
const uint kDistanceCulled = 2u;
const uint kSmallCulled = 3u;
const uint kFrustumVisible = 4u;
const uint kOcclusionCulled = 5u;
const uint kVisible = 6u;
const uint kLodCulled = 7u;
const uint kCrossFades = 8u;
const uint kInstances = 9u;
const uint kInvalid = 10u;
const uint kOverflow = 11u;
const uint kCounterCount = 12u;

shared uint localCounters[kCounterCount];

void count(uint counter) { atomicAdd(localCounters[counter], 1u); }

// projectedRadiusPixels (culling.cpp), même ordre d'opérations.
float projectedRadius(vec3 center, vec3 extents)
{
    float radius = length(extents);
    if ((cull.counts.w & 1u) != 0u)
    {
        return radius * cull.view.x * cull.view.y * 0.5;
    }
    float distance = length(center - cull.eye.xyz);
    if (distance <= radius)
    {
        return 3.0e38;
    }
    return radius / distance * cull.view.x * cull.view.y * 0.5;
}

#ifdef OROSMO_HIZ
// Vrai si la boîte est entièrement derrière la profondeur de l'image précédente (repère A26 : v = 0 en haut, NDC y = +1 en haut ;
// reverse-Z : 1 au plus près). Prudent : un coin derrière la caméra, une boîte hors de l'image précédente ou touchant le plan proche
// n'est jamais rejetée.
bool occluded(vec3 lo, vec3 hi)
{
    vec2 ndcMin = vec2(3.0e38);
    vec2 ndcMax = vec2(-3.0e38);
    float nearest = 0.0;
    for (int corner = 0; corner < 8; ++corner)
    {
        vec3 p = vec3((corner & 1) != 0 ? hi.x : lo.x, (corner & 2) != 0 ? hi.y : lo.y, (corner & 4) != 0 ? hi.z : lo.z);
        vec4 clip = cull.occlusionViewProj * vec4(p, 1.0);
        if (clip.w <= 1.0e-5)
        {
            return false;
        }
        vec3 ndc = clip.xyz / clip.w;
        ndcMin = min(ndcMin, ndc.xy);
        ndcMax = max(ndcMax, ndc.xy);
        nearest = max(nearest, ndc.z);
    }
    if (nearest >= 1.0 || ndcMax.x < -1.0 || ndcMin.x > 1.0 || ndcMax.y < -1.0 || ndcMin.y > 1.0)
    {
        return false;
    }
    ndcMin = clamp(ndcMin, vec2(-1.0), vec2(1.0));
    ndcMax = clamp(ndcMax, vec2(-1.0), vec2(1.0));
    vec2 size = cull.hiz.xy;
    // Rectangle en pixels du niveau 0, élargi d'un pixel (arrondis, jitter).
    vec2 p0 = vec2(ndcMin.x * 0.5 + 0.5, 0.5 - ndcMax.y * 0.5) * size - 1.0;
    vec2 p1 = vec2(ndcMax.x * 0.5 + 0.5, 0.5 - ndcMin.y * 0.5) * size + 1.0;
    float extent = max(p1.x - p0.x, p1.y - p0.y);
    int levels = int(cull.hiz.z);
    int level = clamp(int(ceil(log2(max(extent, 1.0)))), 0, levels - 1);
    ivec2 levelSize = textureSize(hizTexture, level);
    float scale = exp2(-float(level));
    ivec2 t0 = clamp(ivec2(floor(max(p0, vec2(0.0)) * scale)), ivec2(0), levelSize - 1);
    ivec2 t1 = clamp(ivec2(floor(max(p1, vec2(0.0)) * scale)), ivec2(0), levelSize - 1);
    float farthest = 1.0;
    for (int y = t0.y; y <= t1.y; ++y)
    {
        for (int x = t0.x; x <= t1.x; ++x)
        {
            farthest = min(farthest, texelFetch(hizTexture, ivec2(x, y), level).r);
        }
    }
    return nearest < farthest;
}
#endif

float switchAt(LodSettings s, int j) { return s.switches[j >> 2][j & 3]; }

void emit(SceneObject o, uint level, float dither)
{
    uint mesh = o.lods[level >> 2u][level & 3u];
    uint material = o.info.w;
    uint meshCount = cull.counts.y;
    if (mesh >= meshCount || material >= cull.counts.z)
    {
        count(kInvalid);
        return;
    }
    uint command = material * meshCount + tables[mesh];
    uint capacity = tables[meshCount + command];
    uint index = atomicAdd(commands[command].instanceCount, 1u);
    if (index >= capacity)
    {
        atomicAdd(commands[command].instanceCount, 0xFFFFFFFFu); // annule l'ajout : la commande ne déborde jamais de sa plage
        count(kOverflow);
        return;
    }
    Instance instance;
    instance.model[0] = o.model[0];
    instance.model[1] = o.model[1];
    instance.model[2] = o.model[2];
    instance.model[3] = o.model[3] - vec4(cull.origin.xyz, 0.0);
    instance.normal[0] = vec4(o.normal[0].xyz, dither);
    instance.normal[1] = o.normal[1];
    instance.normal[2] = o.normal[2];
    instance.color = o.color;
    instances[commands[command].firstInstance + index] = instance;
    count(kInstances);
}

uint cullObject(uint slot)
{
    SceneObject o = objects[slot];
    if ((o.info.x & 1u) == 0u)
    {
        return 0u;
    }
    count(kObjects);
    vec3 lo = o.boundsMin.xyz;
    vec3 hi = o.boundsMax.xyz;
    vec3 center = (lo + hi) * 0.5;
    vec3 extents = (hi - lo) * 0.5;
    uint flags = 1u;
    if ((cull.counts.w & 2u) != 0u)
    {
        int planeCount = int(cull.eye.w);
        for (int i = 0; i < planeCount; ++i)
        {
            vec4 p = cull.planes[i];
            float distance = dot(p.xyz, center) + p.w;
            float reach = dot(abs(p.xyz), extents);
            if (distance + reach < 0.0)
            {
                count(kFrustumCulled);
                return flags;
            }
        }
        if (cull.view.w > 0.0)
        {
            vec3 nearestPoint = clamp(cull.eye.xyz, lo, hi);
            if (length(nearestPoint - cull.eye.xyz) > cull.view.w)
            {
                count(kDistanceCulled);
                return flags;
            }
        }
        if (cull.view.z > 0.0 && projectedRadius(center, extents) < cull.view.z)
        {
            count(kSmallCulled);
            return flags;
        }
    }
    flags |= 2u;
    count(kFrustumVisible);
#ifdef OROSMO_HIZ
    if (occluded(lo, hi))
    {
        count(kOcclusionCulled);
        return flags;
    }
#endif
    flags |= 4u;
    count(kVisible);

    // selectLod (lod.cpp).
    uint levelCount = max(o.info.y, 1u);
    if ((cull.counts.w & 4u) == 0u)
    {
        emit(o, 0u, 0.0);
        return flags | 8u;
    }
    LodSettings s = lodSettings[o.info.z];
    float distance = length(center - cull.eye.xyz);
    if (!(distance >= 0.0))
    {
        distance = 0.0;
    }
    float d = distance * (s.params.z > 0.0 ? s.params.z : 1.0);
    float width = max(s.params.x, 0.0);
    float halfWidth = width * 0.5;
    int switches = min(int(s.params.w), int(levelCount) - 1);
    int level = switches;
    float crossT = 0.0;
    bool crossing = false;
    for (int j = 0; j < switches; ++j)
    {
        float sw = switchAt(s, j);
        if (d < sw - halfWidth)
        {
            level = j;
            break;
        }
        if (width > 0.0 && d < sw + halfWidth)
        {
            level = j;
            crossT = (d - (sw - halfWidth)) / width;
            crossing = crossT > 0.0;
            break;
        }
    }
    float cullDistance = s.params.y;
    if (cullDistance > 0.0)
    {
        if (d >= cullDistance + halfWidth)
        {
            count(kLodCulled);
            return flags;
        }
        if (width > 0.0 && d > cullDistance - halfWidth)
        {
            float t = (d - (cullDistance - halfWidth)) / width;
            emit(o, uint(crossing ? level + 1 : level), t);
            return flags | 8u;
        }
    }
    if (crossing)
    {
        count(kCrossFades);
        emit(o, uint(level), crossT);
        emit(o, uint(level + 1), -crossT);
        return flags | 8u;
    }
    emit(o, uint(level), 0.0);
    return flags | 8u;
}

void main()
{
    uint local = gl_LocalInvocationIndex;
    if (local < kCounterCount)
    {
        localCounters[local] = 0u;
    }
    memoryBarrierShared();
    barrier();
    uint slot = gl_GlobalInvocationID.x;
    if (slot < cull.counts.x)
    {
        visibility[slot] = cullObject(slot);
    }
    memoryBarrierShared();
    barrier();
    if (local < kCounterCount && localCounters[local] != 0u)
    {
        atomicAdd(stats[local], localCounters[local]);
    }
}
