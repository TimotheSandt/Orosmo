#version 450
// REN-18 : histogramme de la luminance de la scène (256 cases en log2), par tuiles de 16×16 en mémoire partagée.
#include "post_common.glsl"

layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0) uniform sampler2D scene;
layout(set = 0, binding = 1, std430) buffer Histogram { uint bins[256]; };

layout(push_constant) uniform Push
{
    vec4 params; // x : log2 minimal, y : log2 maximal, zw : taille de la scène
} pc;

shared uint localBins[256];

void main()
{
    uint index = gl_LocalInvocationIndex;
    localBins[index] = 0u;
    memoryBarrierShared();
    barrier();
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (texel.x < int(pc.params.z) && texel.y < int(pc.params.w))
    {
        vec3 rgb = texelFetch(scene, texel, 0).rgb;
        atomicAdd(localBins[histogramBin(luminance(rgb), pc.params.x, pc.params.y)], 1u);
    }
    memoryBarrierShared();
    barrier();
    if (localBins[index] != 0u)
    {
        atomicAdd(bins[index], localBins[index]);
    }
}
