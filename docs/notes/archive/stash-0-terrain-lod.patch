+std::vector<unsigned int> BuildSampledAxis(unsigned int start, unsigned int end, unsigned int step)
+{
+    std::vector<unsigned int> samples;
+    samples.reserve(((end - start) / step) + 2);
+    for (unsigned int value = start; value < end; value += step)
+    {
+        samples.push_back(value);
+    }
+    if (samples.empty() || samples.back() != end)
+    {
+        samples.push_back(end);
+    }
+    return samples;
+}
+
+unsigned int SelectTerrainLod(const glm::vec3 &cameraPosition, const glm::vec3 &minBounds, const glm::vec3 &maxBounds)
+{
+    const glm::vec3 center = (minBounds + maxBounds) * 0.5f;
+    const float distance = glm::length(glm::vec2(cameraPosition.x - center.x, cameraPosition.z - center.z));
+    if (distance < TerrainLod0Distance)
+    {
+        return 0;
+    }
+    if (distance < TerrainLod1Distance)
+    {
+        return 1;
+    }
+    return 2;
+}
+
