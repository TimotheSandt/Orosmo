+VkRect2D GetCurrentClearRect() noexcept
+{
+    VkRect2D clearRect{};
+
+    const int viewportWidth = state.viewport[2] > 0 ? state.viewport[2] : static_cast<int>(currentExtent.width);
+    const int viewportHeight = state.viewport[3] > 0 ? state.viewport[3] : static_cast<int>(currentExtent.height);
+
+    if (state.scissorTest)
+    {
+        clearRect.offset.x = scissorRect[0];
+        clearRect.offset.y = viewportHeight - (scissorRect[1] + scissorRect[3]);
+        clearRect.extent.width = static_cast<std::uint32_t>(std::max(scissorRect[2], 0));
+        clearRect.extent.height = static_cast<std::uint32_t>(std::max(scissorRect[3], 0));
+    }
+    else
+    {
+        clearRect.offset = {0, 0};
+        clearRect.extent.width = static_cast<std::uint32_t>(std::max(viewportWidth, 0));
+        clearRect.extent.height = static_cast<std::uint32_t>(std::max(viewportHeight, 0));
+    }
+
+    return clearRect;
+}
+
+void ClearAttachments(bool clearColorAttachment, bool clearDepthAttachment, const glm::vec4 *colorOverride) noexcept
+{
+    if (currentCommandBuffer == VK_NULL_HANDLE || currentRenderPass == VK_NULL_HANDLE)
+    {
+        return;
+    }
+
+    const VkRect2D clearRect = GetCurrentClearRect();
+    if (clearRect.extent.width == 0 || clearRect.extent.height == 0)
+    {
+        return;
+    }
+
+    std::vector<VkClearAttachment> attachments;
+    attachments.reserve(2);
+
+    if (clearColorAttachment)
+    {
+        VkClearAttachment colorAttachment{};
+        colorAttachment.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+        colorAttachment.colorAttachment = 0;
+        const glm::vec4 clear = colorOverride != nullptr ? *colorOverride : ::VulkanRenderState::GetClearColor();
+        colorAttachment.clearValue.color = {clear.r, clear.g, clear.b, clear.a};
+        attachments.push_back(colorAttachment);
+    }
+
+    if (clearDepthAttachment)
+    {
+        VkClearAttachment depthAttachment{};
+        depthAttachment.aspectMask = VK_IMAGE_ASPECT_DEPTH_BIT;
+        depthAttachment.clearValue.depthStencil = {1.0f, 0};
+        attachments.push_back(depthAttachment);
+    }
+
+    if (attachments.empty())
+    {
+        return;
+    }
+
+    VkClearRect clearRegion{};
+    clearRegion.rect = clearRect;
+    clearRegion.baseArrayLayer = 0;
+    clearRegion.layerCount = 1;
+
+    vkCmdClearAttachments(currentCommandBuffer, static_cast<std::uint32_t>(attachments.size()), attachments.data(), 1, &clearRegion);
+}
+
+VkViewport MakeViewport(int x, int y, int width, int height) noexcept
+{
+    VkViewport viewport{};
+    viewport.x = static_cast<float>(x);
+    viewport.y = static_cast<float>(y + height);
+    viewport.width = static_cast<float>(width);
+    viewport.height = -static_cast<float>(height);
+    viewport.minDepth = 0.0f;
+    viewport.maxDepth = 1.0f;
+    return viewport;
+}
+
+VkRect2D MakeScissorRect(int x, int y, int width, int height) noexcept
+{
+    VkRect2D rect{};
+    const int viewportHeight = state.viewport[3] > 0 ? state.viewport[3] : static_cast<int>(currentExtent.height);
+    rect.offset.x = x;
+    rect.offset.y = viewportHeight - (y + height);
+    rect.extent.width = static_cast<std::uint32_t>(std::max(width, 0));
+    rect.extent.height = static_cast<std::uint32_t>(std::max(height, 0));
+    return rect;
+}
+
+void ApplyViewportIfPossible() noexcept
+{
+    if (currentCommandBuffer == VK_NULL_HANDLE)
+    {
+        return;
+    }
+
+    const VkViewport viewport = MakeViewport(state.viewport[0], state.viewport[1], state.viewport[2], state.viewport[3]);
+    vkCmdSetViewport(currentCommandBuffer, 0, 1, &viewport);
+}
+
+void ApplyScissorIfPossible() noexcept
+{
+    if (currentCommandBuffer == VK_NULL_HANDLE)
+    {
+        return;
+    }
+
+    VkRect2D rect{};
+    if (state.scissorTest)
+    {
+        rect = MakeScissorRect(scissorRect[0], scissorRect[1], scissorRect[2], scissorRect[3]);
+    }
+    else
+    {
+        rect.offset = {0, 0};
+        rect.extent.width = state.viewport[2] > 0 ? static_cast<std::uint32_t>(state.viewport[2]) : currentExtent.width;
+        rect.extent.height = state.viewport[3] > 0 ? static_cast<std::uint32_t>(state.viewport[3]) : currentExtent.height;
+    }
+
+    vkCmdSetScissor(currentCommandBuffer, 0, 1, &rect);
+}
+
 } // namespace
 
