// UI-08 : vue de test, version 3 : un champ lié de plus que la v1 (structure changée, tests/app/view_host_tests.cpp).
import "orosmo/ui"
import "app/view_module/hot_state.hpp"

view HotView {
    @Mutable var state: HotState
    @Mutable var other: HotState

    VBox {
        Label("\(state.title)").id("title")
        Checkbox("Flag", checked: $state.flag).id("flag")
        Button("Press").onClick(state.press).id("press")
        ScrollView {
            VBox {
                Label("Line 1")
                Label("Line 2")
                Label("Line 3")
                Label("Line 4")
                Label("Line 5")
                Label("Line 6")
                Label("Line 7")
                Label("Line 8")
            }
        }
        .height(30)
        .id("list")
        Section("More", expanded: true) {
            Label("Inside")
        }
        .id("more")
    }
}
